PYTHONDONTWRITEBYTECODE=1

# ============================================================
# LLM API Keys — fill in your own keys
# ============================================================
# Primary backend (OpenAI-compatible proxy)
OPENAI_DS_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=YOUR_BASE_URL_HERE
OPENAI_MODEL=deepseek-v4-flash

# Fallback: DeepSeek official
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub tokens (for data collection)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_TOKEN2=YOUR_GITHUB_TOKEN_HERE

# Model-specific keys (for LLM config experiment)
GPT_5_MINI_API_KEY=YOUR_API_KEY_HERE
GPT_5_MINI_BASE_URL=YOUR_BASE_URL_HERE
GPT_5_MINI_MODEL=gpt-5-mini

CLAUDE_SONNET_4_6_API_KEY=YOUR_API_KEY_HERE
CLAUDE_SONNET_4_6_BASE_URL=YOUR_BASE_URL_HERE
CLAUDE_SONNET_4_6_MODEL=claude-sonnet-4-6

GEMINI_3_FLASH_PREVIEW_API_KEY=YOUR_API_KEY_HERE
GEMINI_3_FLASH_PREVIEW_BASE_URL=YOUR_BASE_URL_HERE
GEMINI_3_FLASH_PREVIEW_MODEL=gemini-3-flash-preview

GROK_4_3_API_KEY=YOUR_API_KEY_HERE
GROK_4_3_BASE_URL=YOUR_BASE_URL_HERE
GROK_4_3_MODEL=grok-4.3

# ============================================================
# Project paths — change these to match your environment
# ============================================================
PROJECT_ROOT=/path/to/ExpLoc
MANIFEST_PATH=/path/to/ExpLoc/Dataset/dataset_with_changed_files_filter.json
DATASET_PATH=/path/to/ExpLoc/Dataset/dataset_with_changed_files_filter.json
KG_DIR=/path/to/ExpLoc/KG_Construction/Graphs
ICFG_DIR=/path/to/ExpLoc/Static_Analysis/Results/CodeQL
SCUBA_RESULTS_DIR=/path/to/ExpLoc/Static_Analysis/Results/ScubaTrace
OUTPUT_DIR=/path/to/ExpLoc/Results/Localization
REPO_BASE=/path/to/cloned/repos
# Repo structure: REPO_BASE/{CVE-ID}/{Owner}/{Project} or REPO_BASE/{Owner}_{Project}
