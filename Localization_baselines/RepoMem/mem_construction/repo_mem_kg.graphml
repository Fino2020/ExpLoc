    #0 0x410f6f in getString /root/libming-asan/util/decompile.c:349
    #1 0x4127f1 in newVar_N /root/libming-asan/util/decompile.c:661
    #2 0x41d24c in decompileCALLMETHOD /root/libming-asan/util/decompile.c:2856
