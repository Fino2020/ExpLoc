    #1 0x4355d1 in puts (/src/samurai/samu+0x4355d1)
    #2 0x4cb75f in printstatus /src/samurai-1.2/build.c:273:2
    #3 0x4cc1f1 in jobstart /src/samurai-1.2/build.c:312:3
