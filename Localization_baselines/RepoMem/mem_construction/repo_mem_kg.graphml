allocated by thread T0 here:
    #0 0x7f83a70cf6f7 in malloc (/usr/lib/gcc/x86_64-pc-linux-gnu/4.9.2/libasan.so.1+0x576f7)
    #1 0x4a648c in file_open libarchive/archive_read_open_filename.c:358

```

