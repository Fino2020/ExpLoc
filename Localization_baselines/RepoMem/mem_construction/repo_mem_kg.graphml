    "verification of RSASSA-PSS signatures."
  ],
  "notes" : {
  },
  "schema" : "rsassa_pss_verify_schema.json",
  "testGroups" : [
    {
      "e" : "010001",
      "keyAsn" : "",
      "keyDer" : "",
